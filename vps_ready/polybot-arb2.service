[Unit]
Description=Polymarket arb2 — Oracle Arbitrage (WSS)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/bots
EnvironmentFile=/root/bots/.env
ExecStart=/usr/bin/python3 /root/bots/oracle_arb_wss.py --paper
Restart=on-failure
RestartSec=15
StandardOutput=append:/root/bots/logs/arb2.log
StandardError=append:/root/bots/logs/arb2.log

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/root/bots
ProtectHome=true

[Install]
WantedBy=multi-user.target

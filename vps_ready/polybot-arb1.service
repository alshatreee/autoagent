[Unit]
Description=Polymarket arb1 — Copy Trader
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/bots
EnvironmentFile=/root/bots/.env
ExecStart=/usr/bin/python3 /root/bots/copy_trader.py --paper
Restart=on-failure
RestartSec=15
StandardOutput=append:/root/bots/logs/arb1.log
StandardError=append:/root/bots/logs/arb1.log

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/root/bots
ProtectHome=true

[Install]
WantedBy=multi-user.target

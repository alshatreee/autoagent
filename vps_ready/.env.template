# =====================================================================
# Polymarket Bots — Environment Variables
# =====================================================================
# Copy this file to .env and fill in your real values:
#     cp .env.template .env
#     nano .env
#     chmod 600 .env
#
# NEVER commit .env to git. Verify .gitignore contains ".env".
# Wallet ADDRESSES are public (safe). Wallet PRIVATE KEYS are secrets
# (never paste them in chat, screenshots, or git).
# =====================================================================

# ─── PER-BOT WALLETS (recommended: one wallet per bot) ──────────────
# Each bot trades from its own funded wallet. If a wallet gets flagged
# or drained, the others are isolated. Generate keys offline and paste
# them here ONLY on the VPS.
#
# arb1 — copy_trader
ARB1_FUNDER=0x01e5F00409044be6072A7a7f9fB7DeAF246A34ec
ARB1_PRIVATE_KEY=
ARB1_SIG_TYPE=0

# arb2 — oracle_arb_wss
ARB2_FUNDER=0x17C77b3B5ad4EdCf5E7E0731a46a69B114E00923
ARB2_PRIVATE_KEY=
ARB2_SIG_TYPE=0

# arb3 — sports_consensus_bot
ARB3_FUNDER=0xdBefe89Bfb5Cf18c54Aa50520D3a26bf0c1D1857
ARB3_PRIVATE_KEY=
ARB3_SIG_TYPE=0

# ─── LEGACY shared wallet (only if you want all bots on one wallet) ─
# Leave blank when using per-bot wallets above. Each bot reads its own
# ARBx_* first and falls back to these only if ARBx_* are unset.
POLY_PRIVATE_KEY=
POLY_FUNDER=
POLY_SIG_TYPE=0

# ─── Target wallet for arb1 (the wallet to COPY, not yours) ─────────
# sharky6999 — fill in EXACT 42-char address (lowercase ok)
TARGET_WALLET=0x751a2b86000000000000000000000000000000000

# ─── Alchemy WebSocket for arb2 (oracle_arb_wss) ────────────────────
# Get a free key at https://dashboard.alchemy.com/
ALCHEMY_WSS=wss://polygon-mainnet.g.alchemy.com/v2/YOUR_KEY_HERE

# ─── Telegram notifications (shared by all bots) ────────────────────
# 1. Talk to @BotFather on Telegram, /newbot, copy the token
# 2. Talk to @userinfobot to get your chat id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ─── Optional file overrides ────────────────────────────────────────
SMART_WALLETS_FILE=/root/bots/smart_wallets.json
STATE_FILE=/root/bots/copy_trader_state.json

# ─── Signal Copier (signal_copier.py) ───────────────────────────────
# Telegram userbot credentials (from https://my.telegram.org)
TG_API_ID=
TG_API_HASH=
TG_CHANNEL=Naif_Alert
TG_SESSION=signal_copier

# Exchange: "binance" or "gateio" or "both"
EXCHANGE=binance

# Binance API (spot trading permissions only — never enable withdrawals)
BINANCE_API_KEY=
BINANCE_SECRET=

# Gate.io API
GATE_API_KEY=
GATE_SECRET=

# Signal copier risk params
TRADE_USDT=20
MAX_DAILY_TRADES=5
MAX_DAILY_LOSS=30
MAX_OPEN=3
SIGNAL_STATE=/root/bots/signal_state.json
SIGNAL_LOG=/root/bots/signal_log.jsonl

# =====================================================================
# Polymarket Bots — Environment Variables
# =====================================================================
# Copy this file to .env and fill in your real values:
#     cp .env.template .env
#     nano .env
#     chmod 600 .env
#
# NEVER commit .env to git. Verify .gitignore contains ".env".
# =====================================================================

# ─── Polymarket signing (LIVE only — leave blank for paper) ─────────
POLY_PRIVATE_KEY=
POLY_FUNDER=
# 0=EOA (most common for our wallets), 1=email/magic, 2=browser/Gnosis Safe
POLY_SIG_TYPE=0

# ─── Target wallet for arb1 (copy_trader) ───────────────────────────
# sharky6999 — fill in EXACT 42-char address (lowercase ok)
TARGET_WALLET=0x751a2b86000000000000000000000000000000000

# ─── Alchemy WebSocket for arb2 (oracle_arb_wss) ────────────────────
# Get a free key at https://dashboard.alchemy.com/
ALCHEMY_WSS=wss://polygon-mainnet.g.alchemy.com/v2/YOUR_KEY_HERE

# ─── Telegram notifications (shared by all bots) ────────────────────
# 1. Talk to @BotFather on Telegram, /newbot, copy the token
# 2. Talk to @userinfobot to get your chat id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ─── Optional file overrides ────────────────────────────────────────
SMART_WALLETS_FILE=/root/bots/smart_wallets.json
STATE_FILE=/root/bots/copy_trader_state.json

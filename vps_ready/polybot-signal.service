[Unit]
Description=Signal Copier — Telegram Channel to Binance/Gate.io
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/bots
EnvironmentFile=/root/bots/.env
ExecStart=/usr/bin/python3 /root/bots/signal_copier.py --paper
Restart=on-failure
RestartSec=15
StandardOutput=append:/root/bots/logs/signal.log
StandardError=append:/root/bots/logs/signal.log

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/root/bots
ProtectHome=true

[Install]
WantedBy=multi-user.target
